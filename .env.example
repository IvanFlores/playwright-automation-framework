# Copy to .env (local) or .env.<TEST_ENV> (e.g. .env.staging) and fill in the values.
# Required variables are validated at startup by src/config/Env.ts.
TEST_ENV=local

# Web application under test (required)
BASE_URL=http://localhost:3001

# Test account used by the `authenticatedPage` fixture (required)
TEST_USERNAME=
TEST_PASSWORD=

# Public API used by tests/api (optional, defaults to JSONPlaceholder)
API_BASE_URL=https://jsonplaceholder.typicode.com
