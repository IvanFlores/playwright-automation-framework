{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@pages/*": ["./src/ui/pages/*"],
      "@components/*": ["./src/ui/components/*"],
      "@fixtures": ["./src/fixtures/index"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@data/*": ["./src/data/*"],
      "@config/*": ["./src/config/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@api/*": ["./src/api/*"]
    }
  },
  "include": ["src", "tests", "features", "playwright.config.ts"]
}
